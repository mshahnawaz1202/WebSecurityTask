<%- include('partials/header') %>

<section class="hero-section">
    <div class="hero-content">
        <h1>Healthcare & Pharmacy Portal</h1>
        <p class="subtitle">Prescription Supplies, Medical Devices, and Vital Nutrients.</p>
        <div class="hero-tags">
            <span class="tag">Dual-Mode Security Lab</span>
            <span class="tag">OWASP Demonstrations</span>
            <span class="tag">Blue Team Defenses</span>
        </div>
    </div>
</section>

<!-- Client-side DOM XSS Demonstration Banner -->
<div class="promo-card">
    <div class="promo-body">
        <span class="promo-label">[PROMOTION NOTICE]:</span>
        <div id="promo-banner" class="promo-text">
            Loading special offers... (Modify URL hash e.g. <code>#promo=&lt;img src=x onerror=alert('DOM-XSS')&gt;</code>)
        </div>
    </div>
</div>

<section class="section">
    <div class="section-header">
        <h2>Featured Medical Inventory</h2>
        <a href="/products" class="btn btn-outline">View All Products &rarr;</a>
    </div>

    <div class="product-grid">
        <% if (products && products.length > 0) { %>
            <% products.forEach(function(product) { %>
                <div class="product-card">
                    <div class="product-image" style="background-image: url('<%= product.image_url %>');"></div>
                    <div class="product-info">
                        <span class="product-category"><%= product.category %></span>
                        <h3 class="product-title"><%= product.name %></h3>
                        <p class="product-desc"><%= product.description.substring(0, 80) %>...</p>
                        <div class="product-footer">
                            <span class="product-price">$<%= product.price.toFixed(2) %></span>
                            <a href="/products/<%= product.id %>" class="btn btn-sm btn-primary">Details & Reviews</a>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p>No products loaded.</p>
        <% } %>
    </div>
</section>

<!-- Security Lab Exploit & Test Guidance Panel -->
<section class="lab-guide-card">
    <h3>[TEST MATRIX] Vulnerability Evaluation Suite</h3>
    <p>Use the following test vectors to evaluate the difference between the Vulnerable and Safe modes:</p>
    <div class="guide-grid">
        <div class="guide-box">
            <h4>1. Reflected XSS</h4>
            <p>Search bar input reflected directly into HTML output without sanitization.</p>
            <a href="/search?q=%3Cscript%3Ealert('Reflected-XSS')%3C%2Fscript%3E" class="btn btn-sm btn-outline">Test Reflected Payload</a>
        </div>
        <div class="guide-box">
            <h4>2. Stored XSS</h4>
            <p>Submit review on any product. Payload is saved to SQLite DB and executes on load.</p>
            <a href="/products/1" class="btn btn-sm btn-outline">Go to Product Reviews</a>
        </div>
        <div class="guide-box">
            <h4>3. DOM-Based XSS</h4>
            <p>Client script reads URL hash / query and modifies DOM via innerHTML.</p>
            <a href="/#promo=%3Cimg%20src=x%20onerror=alert('DOM-XSS')%3E" class="btn btn-sm btn-outline">Trigger DOM Payload</a>
        </div>
        <div class="guide-box">
            <h4>4. SQLi Level 1 (Easy)</h4>
            <p>Authentication bypass on login form using SQL injection.</p>
            <a href="/login" class="btn btn-sm btn-outline">Test Login Bypass</a>
        </div>
        <div class="guide-box">
            <h4>5. SQLi Level 2 (Intermediate)</h4>
            <p>Blind Boolean verification on prescription validation API.</p>
            <a href="/promo" class="btn btn-sm btn-outline">Test Blind SQLi</a>
        </div>
        <div class="guide-box">
            <h4>6. SQLi Level 3 (Advanced)</h4>
            <p>Structured UNION extraction chain: Columns &rarr; Tables &rarr; Schema &rarr; Credentials.</p>
            <a href="/products?category=Equipment'%20UNION%20SELECT%201,username,password%20||%20'%20|%20'%20||%20email,balance,role%20FROM%20users%20--" class="btn btn-sm btn-outline">Dump User DB</a>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
