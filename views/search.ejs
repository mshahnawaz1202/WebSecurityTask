<%- include('partials/header') %>

<div class="page-header">
    <h2>Search Results</h2>
    <div class="search-reflection-box">
        <span>Results for search term: </span>
        <strong id="reflected-output">
            <% if (mode === 'vulnerable') { %>
                <!-- VULNERABLE: Direct raw unescaped reflection of query parameter -->
                <%- query %>
            <% } else { %>
                <!-- SAFE: HTML-entity encoded safe output -->
                <%= query %>
            <% } %>
        </strong>
    </div>
    <p class="security-status-note">
        Mode: <strong><%= mode.toUpperCase() %></strong> |
        <% if (mode === 'vulnerable') { %>
            Reflected unescaped into response HTML (XSS executes immediately)
        <% } else { %>
            Neutralized via HTML entity encoding & CSP
        <% } %>
    </p>
</div>

<!-- Reflected XSS Test Launcher -->
<div class="xss-test-card">
    <h4>[TEST VECTORS] Reflected XSS Payloads</h4>
    <p>Click below or paste into the search bar above to test reflection behavior:</p>
    <div class="button-group">
        <a href="/search?q=%3Cscript%3Ealert('Reflected-XSS-Execution!')%3C%2Fscript%3E" class="btn btn-sm btn-outline">
            Payload 1: <code>&lt;script&gt;alert(...)&lt;/script&gt;</code>
        </a>
        <a href="/search?q=%3Cimg%20src=x%20onerror=%22alert('Reflected-IMG-XSS')%22%3E" class="btn btn-sm btn-outline">
            Payload 2: <code>&lt;img src=x onerror=alert(...)&gt;</code>
        </a>
        <a href="/search?q=%3Csvg%2Fonload=alert('Reflected-SVG-XSS')%3E" class="btn btn-sm btn-outline">
            Payload 3: <code>&lt;svg/onload=alert(...)&gt;</code>
        </a>
    </div>
</div>

<!-- Results grid -->
<div class="product-grid">
    <% if (products && products.length > 0) { %>
        <% products.forEach(function(product) { %>
            <div class="product-card">
                <div class="product-info">
                    <span class="product-category"><%= product.category %></span>
                    <h3 class="product-title"><%= product.name %></h3>
                    <p class="product-desc"><%= product.description %></p>
                    <div class="product-footer">
                        <span class="product-price">$<%= product.price.toFixed(2) %></span>
                        <a href="/products/<%= product.id %>" class="btn btn-sm btn-primary">View</a>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="empty-state">
            <p>No products matched the search term.</p>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
